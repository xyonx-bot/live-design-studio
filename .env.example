# Live Design Studio Environment Variables

# JWT signing key (openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Studio login (single admin user — no public registration)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Hermes Agent API server (OpenAI-compatible, same host via docker bridge)
HERMES_AGENT_URL=http://172.19.0.1:8644
# API_SERVER_KEY from ~/.hermes/.env
HERMES_API_KEY=your-hermes-api-server-key
# Model name advertised by the API server (usually the profile name)
HERMES_MODEL=hermes-agent

# Domain (informational)
DOMAIN=live-preview.joyverse.fun
